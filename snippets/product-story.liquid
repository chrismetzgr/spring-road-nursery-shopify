{% comment %}
  product-story-sections.liquid
  ------------------------------
  Renders up to 3 alternating media/text story blocks + one centered quote,
  driven entirely by numbered product metafields:

    {n}_headline     -> single line text
    {n}_description  -> multi-line text
    {n}_image        -> file reference (image)
    {n}_video        -> file reference (video) — takes priority over {n}_image
    1_quote          -> single/multi-line text (rendered once, not per-section)

  A section only renders if it has a headline AND description AND
  (a video OR an image). Sections alternate media left/right based on
  how many have ACTUALLY rendered so far (not their number), starting
  with media-right on the first one rendered. The quote renders after
  the 2nd valid section, or at the end as a fallback if fewer than 2
  sections rendered.

  Usage: drop at the bottom of main-product.liquid (or wherever), e.g.
    {% render 'product-story-sections', product: product %}
{% endcomment %}

{%- style -%}
  .product-story {
    color: var(--font-color-dark);
    margin-top: 6rem;
  }

  .product-story__section {
    display: flex;
    flex-direction: column;
    background: transparent;
  }

  .product-story__media {
    order: 0;
    min-height: 20rem;
  }

  .product-story__text {
    order: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 3rem 2.5rem;
  }

  .product-story__media img,
  .product-story__media video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-story__headline {
    margin: 0 0 1.5rem 0;
  }

  .product-story__description {
    margin: 0;
  }

  .product-story__quote {
    text-align: center;
    padding: 10rem 20rem;
    font-family: "Akzidenz-Grotesk Pro", sans-serif;
    font-stretch: expanded;
    letter-spacing: 1px;
  }

  .product-story__quote p {
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    .product-story__section {
      flex-direction: row;
      min-height: 45rem;
    }

    .product-story__media,
    .product-story__text {
      width: 50%;
    }

    .product-story__media {
      min-height: unset;
    }

    .product-story__text {
      padding: 4rem 6rem;
    }

    /* media on the right: media renders second visually */
    .product-story__section--media-right .product-story__media {
      order: 1;
    }

    .product-story__section--media-right .product-story__text {
      order: 0;
    }

    /* media on the left: default DOM order already handles this */
    .product-story__section--media-left .product-story__media {
      order: 0;
    }

    .product-story__section--media-left .product-story__text {
      order: 1;
    }
  }
{%- endstyle -%}

<div class="product-story">
  {%- liquid
    assign valid_count = 0
    assign quote = product.metafields.custom['1_quote'].value | default: "Bauhaus copper mug seitan supreme wolf cut readymade. Breadcrumbing ethical irony asymmetrical cliche brainrot cray enamel pin rams gut health semiotics VHS hot chicken offill meditation."
  -%}

  {%- for i in (1..3) -%}
    {%- liquid
      assign headline_key = i | append: '_headline'
      assign description_key = i | append: '_description'
      assign image_key = i | append: '_image'
      assign video_key = i | append: '_video'

      assign headline = product.metafields.custom[headline_key].value | default: 'HEADLINE'
      assign description = product.metafields.custom[description_key].value | default: "I'm baby four dollar toast girl dinner brainrot, ayahuasca authentic umami akerman cornhole PBR&B supper club artisan air plant coloring book. Tote bag tarot pull asymmetrical gut health hipster runoff. Freegan kogi meditation monstera food truck guided by voices, feral tumeric jawn birkenstocks bone broth omakase burrata."
      assign image = product.metafields.custom[image_key].value
      assign video = product.metafields.custom[video_key].value

      if video != blank and video.media_type == 'VIDEO'
        assign has_media = true
      elsif image != blank
        assign has_media = true
      endif
    -%}

    {%- if headline != blank and description != blank -%}
      {%- assign valid_count = valid_count | plus: 1 -%}
      {%- assign side_check = valid_count | modulo: 2 -%}
      {%- if side_check == 1 -%}
        {%- assign side_class = 'product-story__section--media-right' -%}
      {%- else -%}
        {%- assign side_class = 'product-story__section--media-left' -%}
      {%- endif -%}

      <div class="product-story__section {{ side_class }}">
        <div class="product-story__media">
          {%- if video != blank and video.media_type == 'VIDEO' -%}
            {{ video | video_tag: autoplay: false, controls: true, loop: false }}
          {%- else -%}
            {%- if image != blank -%}
            {{ image | image_url: width: 1500 | image_tag: loading: 'lazy', widths: '600,900,1200,1500' }}
            {%- else -%}
            <img
                src="{{ 'slideshow-inside-greenhouse.png' | asset_url }}"
                alt=""
                loading="lazy"
                width: "1500"
                height: "1500"
            >
            {%- endif -%}          
        {%- endif -%}
        </div>
        <div class="product-story__text">
          <h1 class="product-story__headline">{{ headline | escape }}</h1>
          <div class="product-story__description rte">{{ description | escape | newline_to_br }}</div>
        </div>
      </div>

      {%- if valid_count == 2 and quote != blank -%}
        <div class="product-story__quote">
          <p>{{ quote | newline_to_br }}</p>
        </div>
        {%- assign quote_rendered = true -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}

  {%- if quote != blank and quote_rendered == blank -%}
    <div class="product-story__quote">
      <p>{{ quote | newline_to_br }}</p>
    </div>
  {%- endif -%}
</div>

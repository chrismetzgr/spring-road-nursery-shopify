{% comment %}
  product-story-sections.liquid

  The entire product story renders only when sections 1 and 2 each have:
    - a headline
    - a description
    - an image or video

  The 1_deeper_quote metafield must also be present.

  When a section has both an image and a video, the image is shown until
  the browser confirms that the video is playing. The image returns if
  playback stops or fails.
{% endcomment %}

{%- liquid
  assign headline_1 = product.metafields.custom['1_deeper_headline'].value
  assign description_1 = product.metafields.custom['deeper_definition_one_description'].value
  assign image_1 = product.metafields.custom['1_deeper_image'].value
  assign video_1 = product.metafields.custom['1_deeper_video'].value

  assign headline_2 = product.metafields.custom['2_deeper_headline'].value
  assign description_2 = product.metafields.custom['2_deeper_description'].value
  assign image_2 = product.metafields.custom['2_deeper_image'].value
  assign video_2 = product.metafields.custom['2_deeper_video'].value

  assign quote = product.metafields.custom['1_deeper_quote'].value
  assign suggested_products = product.metafields.custom['suggested_products'].value

  assign section_1_has_media = false
  if image_1 != blank
    assign section_1_has_media = true
  elsif video_1 != blank and video_1.media_type == 'video'
    assign section_1_has_media = true
  endif

  assign section_2_has_media = false
  if image_2 != blank
    assign section_2_has_media = true
  elsif video_2 != blank and video_2.media_type == 'video'
    assign section_2_has_media = true
  endif

  assign show_product_story = false
  if headline_1 != blank and description_1 != blank and section_1_has_media and headline_2 != blank and description_2 != blank and section_2_has_media and quote != blank
    assign show_product_story = true
  endif
-%}

{%- if show_product_story -%}
  {%- style -%}
    .product-story-container {
      --story-bg: #235800;
      --story-text: #F1EFDF;
      --story-max-width: 1250px;
      --story-gutter: 1.5rem;
      --story-media-width: 440px;

      color: var(--font-color-dark);
      margin-block: 6rem;
    }

    /* Full-bleed band; content is centered and capped at --story-max-width */
    .product-story__section {
      box-sizing: border-box;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2rem;
      width: 100vw;
      margin-left: calc(50% - 50vw);
      padding-block: 2rem;
      padding-inline: max(var(--story-gutter), calc((100vw - var(--story-max-width)) / 2));
      background: var(--story-bg);
      color: var(--story-text);
    }

    .product-story__media {
      width: 100%;
    }

    .product-story__media img,
    .product-story__media video {
      display: block;
      width: 100%;
      height: auto;
    }

    /* Keep the image visible until playback is confirmed. */
    .product-story__media--has-video video {
      display: none;
    }

    .product-story__media--video-playing img {
      display: none;
    }

    .product-story__media--video-playing video {
      display: block;
    }

    .product-story__text {
      width: 100%;
    }

    .product-story__headline {
      margin: 0 0 1.5rem;
    }

    .product-story__description {
      margin: 0;
    }

    .product-story__quote,
    .suggested-products__text {
      font-family: "Akzidenz-Grotesk Pro", sans-serif;
      font-size: 18px;
      font-stretch: expanded;
      letter-spacing: 1px;
    }

    .product-story__quote {
      text-align: center;
      padding: 10px;
    }

    .product-story__quote p {
      margin: 0;
    }

    .product-story__suggested-products-container {
      margin-top: 4rem;
    }

    .product-story__suggested-products {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
      margin-top: 1rem;
    }

    .product-story__suggested-product {
      display: block;
      color: inherit;
      text-decoration: none;
    }

    .product-story__suggested-product img {
      display: block;
      width: 100%;
      height: auto;
    }

    .suggested-product__heading {
      font-family: "Akzidenz-Grotesk Pro", sans-serif;
      font-weight: 500;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      text-align: center;
      margin-top: 10px;
    }

    @media screen and (min-width: 769px) {
      .product-story__section {
        flex-direction: row;
        gap: 7.5rem;
        padding-block: 4rem;
      }

      .product-story__description {
        margin: 0;
        font-size: 17px;
      }

      /* Media is first in the markup, so this flips it to the right */
      .product-story__section--media-right {
        flex-direction: row-reverse;
      }

      .product-story__media {
        flex: 0 1 var(--story-media-width);
        width: auto;
      }

      .product-story__text {
        flex: 1;
        min-width: 0;
        width: auto;
      }

      .product-story__quote {
        padding: 50px 100px;
        font-size: 24px;
      }
    }

    @media screen and (max-width: 599px) {
      .product-story__suggested-products {
        grid-template-columns: 1fr;
      }
    }

    .product-story__media--has-video img {
      display: block;
      width: 100%;
      height: auto;
    }

    /* The video overlays the image without affecting the area's height. */
    .product-story__media--has-video video {
      display: block;
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0;
      transition: opacity 1s ease-in;
    }

    /* Fade the video in; do not hide or fade out the image. */
    .product-story__media--has-video.product-story__media--video-playing video {
      opacity: 1;
    }
  {%- endstyle -%}

  <div class="product-story-container">
    <div class="product-story">
      {%- for i in (1..2) -%}
        {%- liquid
          if i == 1
            assign headline = headline_1
            assign description = description_1
            assign image = image_1
            assign video = video_1
            assign side_class = 'product-story__section--media-right'
          else
            assign headline = headline_2
            assign description = description_2
            assign image = image_2
            assign video = video_2
            assign side_class = 'product-story__section--media-left'
          endif

          assign has_video = false
          if video != blank and video.media_type == 'video'
            assign has_video = true
          endif
        -%}

        <div class="product-story__section {{ side_class }}">
          <div class="product-story__media{% if has_video and image != blank %} product-story__media--has-video{% endif %}"{% if has_video and image != blank %} data-product-story-video-fallback{% endif %}>
            {%- if image != blank -%}
              {{ image | image_url: width: 1600 | image_tag: loading: 'lazy' }}
            {%- endif -%}

            {%- if has_video -%}
              {{ video | video_tag: autoplay: true, controls: false, loop: true, muted: true, playsinline: true }}
            {%- endif -%}
          </div>

          <div class="product-story__text">
            <h1 class="product-story__headline">
              {{ headline | escape }}
            </h1>

            <div class="product-story__description description-text rte">
              {{ description | escape | newline_to_br }}
            </div>
          </div>
        </div>

        {%- if i == 1 -%}
          <div class="product-story__quote">
            <p>{{ quote | newline_to_br }}</p>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div>
      {%- if suggested_products != blank -%}
        <div class="product-story__suggested-products-container">
          <span class="suggested-products__text">YOU MIGHT ALSO LIKE</span>
          <div class="product-story__suggested-products">
            {%- for suggested_product in suggested_products -%}
              <a
                class="product-story__suggested-product"
                href="{{ suggested_product.url }}"
              >
                {%- if suggested_product.featured_image -%}
                  {{
                    suggested_product.featured_image
                    | image_url: width: 600
                    | image_tag: loading: 'lazy', alt: suggested_product.title
                  }}
                {%- endif -%}

                <div class="suggested-product__heading">{{ suggested_product.title }}</div>
              </a>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>

<script>
  (function () {
    function setupProductStoryVideos() {
      document.querySelectorAll('[data-product-story-video-fallback]').forEach(function (media) {
        if (media.dataset.productStoryFallbackReady === 'true') return;

        var video = media.querySelector('video');
        if (!video) return;

        media.dataset.productStoryFallbackReady = 'true';
        video.muted = true;

        function showVideo() {
          media.classList.add('product-story__media--video-playing');
        }

        function showImage() {
          media.classList.remove('product-story__media--video-playing');
        }

        video.addEventListener('playing', showVideo);
        video.addEventListener('pause', showImage);
        video.addEventListener('stalled', showImage);
        video.addEventListener('error', showImage);

        /* Cover a video that started before this script ran. */
        if (!video.paused && video.readyState >= 2) {
          showVideo();
        }

        /* Match the working landing page: reveal when play() succeeds. */
        var playPromise = video.play();

        if (playPromise && typeof playPromise.then === 'function') {
          playPromise.then(showVideo).catch(showImage);
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupProductStoryVideos);
    } else {
      setupProductStoryVideos();
    }
  })();
</script>
{%- endif -%}

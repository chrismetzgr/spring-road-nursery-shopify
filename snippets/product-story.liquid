{% comment %}
  product-story-sections.liquid

  Uses product metafields from the custom namespace:

    1_deeper_headline
    deeper_definition_one_description
    1_deeper_image
    1_deeper_video
    1_deeper_quote

    2_deeper_headline
    2_deeper_description

    suggested_products

  A section renders only when it has:
    - a headline
    - a description
    - an image or video

  Video takes priority over image.

  Media alternates sides based on the number of sections
  that have actually rendered.
{% endcomment %}

{%- style -%}
  .product-story-container {
    --story-bg: #235800;
    --story-text: #F1EFDF;
    --story-max-width: 1250px;
    --story-gutter: 1.5rem;
    --story-media-width: 440px;

    color: var(--font-color-dark);
    margin-block: 6rem;
  }

  /* Full-bleed band; content is centered and capped at --story-max-width */
  .product-story__section {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    padding-block: 4rem;
    padding-inline: max(var(--story-gutter), calc((100vw - var(--story-max-width)) / 2));
    background: var(--story-bg);
    color: var(--story-text);
  }

  /* Media keeps its own aspect ratio; the section grows to fit its height */
  .product-story__media {
    width: 100%;
  }

  .product-story__media img,
  .product-story__media video {
    display: block;
    width: 100%;
    height: auto;
    /* Optional: if ALL media shares one ratio, uncomment to prevent layout
       shift while video loads (e.g. 1 / 2 for 220w x 440h):
       aspect-ratio: 1 / 2; */
  }

  .product-story__text {
    width: 100%;
  }

  .product-story__headline {
    margin: 0 0 1.5rem;
  }

  .product-story__description {
    margin: 0;
  }

  .product-story__quote,
  .suggested-products__text {
    font-family: "Akzidenz-Grotesk Pro", sans-serif;
    font-size: 18px;
    font-stretch: expanded;
    letter-spacing: 1px;
  }

  .product-story__quote {
    text-align: center;
    padding: 10px;
  }

  .product-story__quote p {
    margin: 0;
  }

  .product-story__suggested-products-container {
    margin-top: 4rem;
  }

  .product-story__suggested-products {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    margin-top: 1rem;
  }

  .product-story__suggested-product {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .product-story__suggested-product img {
    display: block;
    width: 100%;
    height: auto;
  }

  .suggested-product__heading {
    font-family: "Akzidenz-Grotesk Pro", sans-serif;
    font-weight: 500;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    text-align: center;
    margin-top: 10px;
  }

  @media screen and (min-width: 769px) {
    .product-story__section {
      flex-direction: row;
    }

    /* Media is first in the markup, so this flips it to the right */
    .product-story__section--media-right {
      flex-direction: row-reverse;
    }

    .product-story__media {
      flex: 0 1 var(--story-media-width);
      width: auto;
    }

    .product-story__text {
      flex: 1;
      min-width: 0;
      width: auto;
    }

    .product-story__quote {
      padding: 50px 100px;
      font-size: 24px;
    }
  }

  @media screen and (max-width: 599px) {
    .product-story__suggested-products {
      grid-template-columns: 1fr;
    }
  }
{%- endstyle -%}

<div class="product-story-container">
  <div class="product-story">
    {%- liquid
      assign total_valid_count = 0
      assign valid_count = 0
      assign quote_rendered = false
      assign quote = product.metafields.custom['1_deeper_quote'].value
    -%}

    {% comment %}
      First pass:
      Count how many complete sections exist so the quote can be placed
      after section 1 when there are multiple valid sections.
    {% endcomment %}

    {%- for i in (1..3) -%}
      {%- liquid
        assign headline_key = i | append: '_deeper_headline'
        assign image_key = i | append: '_deeper_image'
        assign video_key = i | append: '_deeper_video'

        assign headline = product.metafields.custom[headline_key].value
        assign image = product.metafields.custom[image_key].value
        assign video = product.metafields.custom[video_key].value
        assign description = blank

        if i == 1
          assign description = product.metafields.custom['deeper_definition_one_description'].value
        elsif i == 2
          assign description = product.metafields.custom['2_deeper_description'].value
        elsif i == 3
          assign description = product.metafields.custom['3_deeper_description'].value
        endif

        assign has_media = false

        if video != blank and video.media_type == 'video'
          assign has_media = true
        elsif image != blank
          assign has_media = true
        endif
      -%}

      {%- if headline != blank and description != blank and has_media -%}
        {%- assign total_valid_count = total_valid_count | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}

    {% comment %}
      Second pass:
      Render the sections.
    {% endcomment %}

    {%- for i in (1..3) -%}
      {%- liquid
        assign headline_key = i | append: '_deeper_headline'
        assign image_key = i | append: '_deeper_image'
        assign video_key = i | append: '_deeper_video'

        assign headline = product.metafields.custom[headline_key].value
        assign image = product.metafields.custom[image_key].value
        assign video = product.metafields.custom[video_key].value
        assign description = blank

        if i == 1
          assign description = product.metafields.custom['deeper_definition_one_description'].value
        elsif i == 2
          assign description = product.metafields.custom['2_deeper_description'].value
        elsif i == 3
          assign description = product.metafields.custom['3_deeper_description'].value
        endif

        assign has_media = false

        if video != blank and video.media_type == 'video'
          assign has_media = true
        elsif image != blank
          assign has_media = true
        endif
      -%}

      {%- if headline != blank and description != blank and has_media -%}
        {%- assign valid_count = valid_count | plus: 1 -%}
        {%- assign side_check = valid_count | modulo: 2 -%}

        {%- if side_check == 1 -%}
          {%- assign side_class = 'product-story__section--media-right' -%}
        {%- else -%}
          {%- assign side_class = 'product-story__section--media-left' -%}
        {%- endif -%}

        <div class="product-story__section {{ side_class }}">
          <div class="product-story__media">
            {%- if video != blank and video.media_type == 'video' -%}
              {{ video | video_tag: autoplay: true, controls: false, loop: true, audio: false }}
            {%- elsif image != blank -%}
              {{ image | image_url: width: 1600 | image_tag: loading: 'lazy' }}
            {%- endif -%}
          </div>

          <div class="product-story__text">
            <h1 class="product-story__headline">
              {{ headline | escape }}
            </h1>

            <div class="product-story__description description-text rte">
              {{ description | escape | newline_to_br }}
            </div>
          </div>
        </div>

        {% comment %}
          If there is more than one valid section, place the quote
          between section 1 and section 2.
        {% endcomment %}

        {%- if valid_count == 1 and total_valid_count > 1 and quote != blank -%}
          <div class="product-story__quote">
            <p>{{ quote | newline_to_br }}</p>
          </div>

          {%- assign quote_rendered = true -%}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}

    {% comment %}
      If there is only one valid section, place the quote after it.
    {% endcomment %}

    {%- if quote != blank and quote_rendered == false -%}
      <div class="product-story__quote">
        <p>{{ quote | newline_to_br }}</p>
      </div>
    {%- endif -%}

  </div>
  <div>

    {%- assign suggested_products = product.metafields.custom['suggested_products'].value -%}

    {%- if suggested_products != blank -%}
      <div class="product-story__suggested-products-container">
        <span class="suggested-products__text">YOU MIGHT ALSO LIKE</span>
        <div class="product-story__suggested-products">
          {%- for suggested_product in suggested_products -%}
            <a
              class="product-story__suggested-product"
              href="{{ suggested_product.url }}"
            >
              {%- if suggested_product.featured_image -%}
                {{
                  suggested_product.featured_image
                  | image_url: width: 600
                  | image_tag: loading: 'lazy', alt: suggested_product.title
                }}
              {%- endif -%}

              <div class="suggested-product__heading">{{ suggested_product.title }}</div>
            </a>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%} 
  </div>
</div>

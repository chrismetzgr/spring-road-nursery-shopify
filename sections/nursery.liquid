{% render 'email-collection-popup' %}

<main class="srn-nursery" id="nursery-page">
  <!-- Hero Image Slideshow -->
  <div class="srn-nursery__hero">
    <img 
      src="{{ 'slideshow-sprout.png' | asset_url }}" 
      alt="Spring Road Nursery terraced gardens"
      class="srn-nursery__hero-image"
      width="1370" 
      height="630"
    />
    <img 
      src="{{ 'slideshow-inside-greenhouse.png' | asset_url }}" 
      alt="Spring Road Nursery terraced gardens"
      class="srn-nursery__hero-image srn-nursery__hero-image--overlay"
      width="1370" 
      height="630"
    />
  </div>

  <!-- Navigation Menu -->
  <nav class="srn-nursery__nav" aria-label="Nursery page navigation">
    <a href="#plants" class="srn-nursery__nav-link">Our Plants</a>
    <span class="srn-nursery__nav-divider" aria-hidden="true">|</span>
    <a href="#hours" class="srn-nursery__nav-link">Our Hours</a>
    <span class="srn-nursery__nav-divider" aria-hidden="true">|</span>
    <a href="#contact" class="srn-nursery__nav-link">Contact Us</a>
    <span class="srn-nursery__nav-divider" aria-hidden="true">|</span>
    <a href="#what-we-do" class="srn-nursery__nav-link">What We Do</a>
  </nav>

  <!-- Content Sections -->
  <div class="srn-nursery__content">

    <!-- Plants Section -->
    <section id="plants" class="srn-nursery__section">
      <div class="srn-nursery__heading">
        <img 
          src="{{ 'our-plants.png' | asset_url }}" 
          alt="Our Plants"
          class="srn-nursery__heading-image"
          width="auto" 
          height="75"
        />

      </div>
      <div class="srn-nursery__text">
        <p class="srn-nursery__quote">"Plant a garden in which strange plants grow and mysteries bloom. The need for mystery is greater than the need for an answer." —Ken Kesey</p>
        <p>We propagate thousands of plants from seed, cuttings, and division.</p>
        
        <p>Each spring, we share a new list of the plants we grow and offer for the season. It will be published here and shared with our subscribers.</p>
        
        <p>
          <a class="srn-nursery__link wavy-underline" href="https://drive.google.com/file/d/1AZrTFmaLNkuT1TQ0JMJy2EdIxyc_j3hO/view?usp=sharing">PLANT LIST 2026.PDF</a>
        </p>
      </div>
    </section>

    <!-- Hours Section -->
    <section id="hours" class="srn-nursery__section">
      <div class="srn-nursery__heading">
        <img 
          src="{{ 'hours.png' | asset_url }}" 
          alt="Our Hours"
          class="srn-nursery__heading-image"
          width="auto" 
          height="75"
        />

      </div>
      <div class="srn-nursery__hours-grid">
        <div class="srn-nursery__hours-block">
          <div class="srn-nursery__hours-day">We are open </div>
          <div class="srn-nursery__hours-time">friday to sunday 10am-4pm</div>
        </div>
      </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="srn-nursery__section srn-nursery__section--contact">
      <div class="srn-nursery__heading">
        <img 
          src="{{ 'contact.png' | asset_url }}" 
          alt="Contact Us"
          class="srn-nursery__heading-image"
          width="auto" 
          height="75"
        />
      </div>
      For all inquiries, please contact us at:
      <a href="mailto:hello@springroadnursery.com" class="srn-nursery__contact-email">
        hello@springroadnursery.com
      </a>
    </section>

    <!-- What We Do Section -->
    <section id="what-we-do" class="srn-nursery__section">
      <div class="srn-nursery__heading">
        <img 
          src="{{ 'what-we-do.png' | asset_url }}" 
          alt="What We Do"
          class="srn-nursery__heading-image"
          width="auto" 
          height="75"
        />
      </div>
      <article class="srn-nursery__text srn-nursery__text--left-align">

        <p>Cross the covered bridge in Tunbridge village, follow the road as it climbs the mountain and turns to dirt, and you’ll arrive at Spring Road Nursery: our home and hillside farm in the mountains of Vermont. What began as an old pasture has become a living library of rare and unusual plants, a terracotta studio, and a place for imagining and making useful objects that carry the traditions of the garden forward.</p>
        
        <p>Our relationship with the earth begins with plants. We grow many from seed and propagate others here on the farm, learning from them as they move through the greenhouse and into the garden. That same attention extends to the terracotta we build by hand and to the objects we make with Vermont craftspeople, whose knowledge of wood, iron, glass, and other materials expands what is possible here.</p>

        <p>We believe a garden is never quite finished. It is a place of curiosity, beauty, work, surprise, and constant change. A way of paying attention to the seasons and to the living world around us. Everything we do at Spring Road grows from that belief: what we care for has a way of caring for us in return.</p>

        <p>For us, it’s all a way of coming back to earth.</p>

        <p>Bryan & Adam</p>
      </article>
    </section>

  </div>
</main>
<style>
/* ============================================
   NURSERY PAGE STYLES
   ============================================ */

/* Base/Mobile Styles (Mobile-First Approach) */
.srn-nursery {
  margin-top: 0;
  margin-bottom: 75px;
}

/* Hero Section */
.srn-nursery__hero {
  max-height: 630px;
  width: 100%;
  display: flex;
  justify-content: center;
  position: relative;
}

.srn-nursery__hero-image {
  max-width: 1370px;
  width: 100%;
  height: auto;
  opacity: 1;
  animation: srn-fadeIn 0.5s ease-out;
  transition: opacity 1.5s ease-in-out;
}

.srn-nursery__hero-image--overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  margin: 0 auto;
  animation: none;
  opacity: 0;
}

@keyframes srn-fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

/* Navigation */
.srn-nursery__nav {
  display: flex;
  justify-content: center;
  gap: 3px;
  align-items: center;
  max-width: 700px;
  width: 100%;
  margin: 15px auto 0;
  padding: 0 20px;
  font-family: var(--font-family-secondary);
  font-size: 9px;
  font-stretch: expanded;
  text-transform: uppercase;
}

@media (max-width: 372px){
  .srn-nursery__nav {
    font-size: 7px;
  }
}

.srn-nursery__nav-link,
.srn-nursery__nav-link:visited {
  color: var(--font-color-dark-secondary);
}

.srn-nursery__nav-link {
  transition: opacity 0.2s ease;
}

.srn-nursery__nav-link:hover,
.srn-nursery__nav-link:focus {
  opacity: 0.5;
}

.srn-nursery__nav-divider {
  color: var(--font-color-dark-secondary);
}

/* Content Container */
.srn-nursery__content {
  font-size: 15px;
  padding: 0 1%;
  color: var(--font-color-dark-secondary);
}

.srn-nursery__content img {
  margin: auto;
}

.srn-nursery__content a {
  color: var(--font-color-dark-secondary);
}

/* Section Base Styles */
.srn-nursery__section {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  max-width: 850px;
  width: 100%;
  margin: 0 auto;
  padding: 0 20px;
  font-size: 17px;
  line-height: 1.15;
  text-align: center;
}

.srn-nursery__heading {
  margin: 80px 0 40px 0 !important;
}

{% comment %} .srn-nursery__quote {
  margin: 80px 0 0 0 !important; 
} {% endcomment %}

.srn-nursery__heading-image {
  display: block;
  height: 30px;
  width: auto;
  max-width: none;
}

/* Text Content */
.srn-nursery__text p {
  margin: 0 0 1em 0;
}

.srn-nursery__text p:last-child {
  margin-bottom: 0;
}

.srn-nursery__text--left-align {
  text-align: left;
}

.srn-nursery__quote {
  font-style: italic;
}

.srn-nursery__link {
  font-family: var(--font-family-secondary);
  font-size: 16px;
  font-weight: 500;
  line-height: 1.5 !important;
}

/* Hours Section */
.srn-nursery__hours-intro {
  margin: 0 0 25px 0;
}

.srn-nursery__hours-grid {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 50px;
  font-family: var(--font-family-secondary);
  text-transform: uppercase;
  letter-spacing: 3px;
  line-height: 1.7;
  font-stretch: expanded;
}

.srn-nursery__hours-block {
  text-align: center;
}

.srn-nursery__hours-day {
  font-weight: 400;
}

.srn-nursery__hours-time {
  font-weight: 300;
}

/* Contact Section */
.srn-nursery__section--contact {
  gap: 0;
  letter-spacing: 2px;
}

.srn-nursery__contact-email,
.srn-nursery__contact-phone {
  text-decoration: none;
  color: inherit;
}

.srn-nursery__contact-email {
  text-decoration: underline;
  text-decoration-thickness: 1px;
  text-underline-offset: 3px;
}

/* ============================================
   DESKTOP BREAKPOINT (>700px)
   ============================================ */
@media (min-width: 700px) {
  .srn-nursery {
    margin-top: 50px;
    margin-bottom: 150px;
  }

  .srn-nursery__nav {
    margin-top: 40px;
    font-size: 14px;
    gap: 20px;
  }

  /* Desktop: Change vertical bars to dots */
  .srn-nursery__nav-divider {
    font-size: 0;
  }
  
  .srn-nursery__nav-divider::before {
    content: '•';
    font-size: 14px;
  }

  .srn-nursery__content {
    font-size: 18px;
  }

  .srn-nursery__section {
    font-size: 25px;
  }

  /* Headings */
  .srn-nursery__heading {
    margin: 150px 0 50px 0 !important;
  }

  {% comment %} .srn-nursery__quote {
    margin: 150px 0 0 0 !important; 
  } {% endcomment %}

  .srn-nursery__section:first-of-type {
    margin-top: 0;
  }

  .srn-nursery__heading-image {
    height: 72px;
  }

  .srn-nursery__link {
    font-size: 20px;
  }

  .srn-nursery__hours-intro {
    margin: 0 0 100px 0;
  }

  .srn-nursery__hours-grid {
    gap: 60px;
    letter-spacing: 5px;
  }

  .srn-nursery__section--contact {
    gap: 0;
    display: flex;
  }
}
</style>
<script>
(function() {
  const slides = [
    '{{ "slideshow-sprout.png" | asset_url }}',
    '{{ "slideshow-outsideshop.png" | asset_url }}',
    '{{ "slidshow-greenhousevibes.png" | asset_url }}',
    '{{ "slideshow-inside-greenhouse.png" | asset_url }}',
    '{{ "slideshow-inside-barn.png" | asset_url }}',
    '{{ "slideshow-field.png" | asset_url }}',
    '{{ "slideshow-truck.png" | asset_url }}',
    '{{ "slideshow-greenhouse.png" | asset_url }}',
    '{{ "slideshow-truckbed.png" | asset_url }}',
    '{{ "slideshow-foggy.png" | asset_url }}',
    '{{ "slideshow-sunset.png" | asset_url }}',
    '{{ "slideshow-sunset.png" | asset_url }}'
  ];
  
  // Preload all images
  slides.forEach(function(src) {
    const img = new Image();
    img.src = src;
  });
  
  const images = document.querySelectorAll('.srn-nursery__hero-image');
  const img1 = images[0];
  const img2 = images[1];
  
  if (!img1 || !img2) return;
  
  let currentIndex = 1;  // slide-2 is already loaded in img2
  let useFirstImage = false;  // Start with false so first crossfade shows img2
  let isFirstTransition = true;  // Track if this is the first transition
  
  function crossfade() {
    // Only increment if it's NOT the first transition
    if (!isFirstTransition) {
      currentIndex = (currentIndex + 1) % slides.length;
    }
    isFirstTransition = false;
    
    if (useFirstImage) {
      img1.src = slides[currentIndex];
      img1.style.opacity = '1';
      img2.style.opacity = '0';
    } else {
      img2.src = slides[currentIndex];
      img2.style.opacity = '1';
      img1.style.opacity = '0';
    }
    
    useFirstImage = !useFirstImage;
  }
  
  // Wait for the animation to complete
  img1.addEventListener('animationend', function() {
    // Remove the animation
    img1.style.animation = 'none';
    // Set opacity explicitly so transitions will work
    img1.style.opacity = '1';
    
    // Wait 7 seconds, then start slideshow
    setTimeout(function() {
      crossfade();
      setInterval(crossfade, 3000);
    }, 2000);
  }, { once: true });
})();
</script>
{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}
{{ 'newsletter-section.css' | asset_url | stylesheet_tag }}

<main class="srn-email-signup" id="email-signup-page">

  <!-- Content Section -->
  <div class="srn-email-signup__content">

    <section class="srn-email-signup__section">
      <article class="srn-email-signup__text">
        <p>From rare plants to handbuilt terracotta, we cultivate the strange and the beautiful on our hillside in Vermont.</p>

        <p>Be the first to hear about what's happening at the nursery.</p>
      </article>

      <div class="srn-email-signup__form-wrapper">
        {% form 'customer', class: 'newsletter-form' %}
          {%- if form.posted_successfully? -%}
            <h3
              class="newsletter-form__message newsletter-form__message--success"
              id="Newsletter-success--page"
              tabindex="-1"
              autofocus
            >
              {{- 'newsletter.success' | t }}
            </h3>
          {%- else -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="newsletter-form__field-wrapper">
              <div class="field">
                <input
                  id="NewsletterForm--page"
                  type="email"
                  name="contact[email]"
                  class="field__input"
                  value="{{ form.email }}"
                  aria-required="true"
                  autocorrect="off"
                  autocapitalize="off"
                  autocomplete="email"
                  {% if form.errors %}
                    autofocus
                    aria-invalid="true"
                    aria-describedby="Newsletter-error--page"
                  {% endif %}
                  placeholder="Your Email Address Here"
                  required
                >
                <label class="newsletter-label field__label" for="NewsletterForm--page">
                  Your Email Address Here
                </label>
                <button
                  type="submit"
                  class="newsletter-form__button field__button"
                  name="commit"
                  id="Subscribe"
                  aria-label="{{ 'newsletter.button_label' | t }}"
                >
                  <span class="svg-wrapper">
                    {{- 'icon-arrow.svg' | inline_asset_content -}}
                  </span>
                </button>
              </div>
              {%- if form.errors -%}
                <small class="newsletter-form__message form__message" id="Newsletter-error--page">
                  <span class="svg-wrapper">
                    {{- 'icon-error.svg' | inline_asset_content -}}
                  </span>
                  {{- form.errors.translated_fields.email | capitalize }}
                  {{ form.errors.messages.email -}}
                </small>
              {%- endif -%}
            </div>
          {%- endif -%}
        {% endform %}
      </div>

      <h2 class="srn-email-signup__title wavy-underline">
        Come Back To Earth
      </h2>
    </section>

  </div>
</main>

<style>
/* ============================================
   EMAIL SIGNUP PAGE STYLES
   (page layout mirrors the garden design page;
   form styling carried over from the popup)
   ============================================ */

/* Base/Mobile Styles (Mobile-First Approach) */
.srn-email-signup {
  /* Form colors: dark green box, light (page background) text.
     If the light color doesn't match your page background, change it here. */
  --srn-signup-dark: var(--font-color-dark);
  --srn-signup-light: var(--color-background-light);

  margin-top: 0;
  margin-bottom: 100px;
}

@keyframes srn-fadeIn {
  to {
    opacity: 1;
  }
}

/* Content Container
   Text color matches the "Your Email Address Here" placeholder */
.srn-email-signup__content {
  display: flex;
  flex-direction: column;
  justify-content: center;
  margin-top: 20px;
  padding: 0 1%;
  color: var(--font-color-dark);
}

.srn-email-signup__content img {
  margin: auto;
}

/* Section */
.srn-email-signup__section {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20px;
  max-width: 850px;
  width: 100%;
  margin: 0 auto 0;
  padding: 0 20px;
  text-align: center;
}

/* Headings */
.srn-email-signup__heading {
  margin: 80px 0 40px 0 !important;
}

.srn-email-signup__heading-image {
  display: block;
  margin: 0 auto;
  height: auto;
  width: 100%;
  max-width: 650px;
}

.srn-email-signup__title {
  font-family: var(--font-family-secondary);
  font-weight: 500;
  text-transform: uppercase;
  font-size: 17px;
  letter-spacing: 1px;
  text-align: center;
  margin: 20px 0 0 0;
  color: var(--font-color-dark);
}

/* Text Content */
.srn-email-signup__text {
  font-size: 17px;
  line-height: 1.15;
  color: var(--font-color-dark);
}

.srn-email-signup__text p {
  margin: 0 0 1em 0;
}

.srn-email-signup__text p:last-child {
  margin-bottom: 0;
}

/* Form (centered) */
.srn-email-signup__form-wrapper {
  width: 95%;
  max-width: 600px;
  margin: 0 auto;
  background-color: var(--srn-signup-dark);
  color: var(--srn-signup-light);
  line-height: 0;
}

.srn-email-signup .field__input {
  background-color: transparent;
  color: var(--srn-signup-light);
  text-align: center;
  transition: none;
}

/* Keep browser autofill from turning the field white */
.srn-email-signup .field__input:-webkit-autofill {
  -webkit-text-fill-color: var(--srn-signup-light);
  box-shadow: 0 0 0 1000px var(--srn-signup-dark) inset;
}

.srn-email-signup__form-wrapper .form__message {
  color: var(--srn-signup-light);
}

.srn-email-signup .field__input:focus {
  transition: none;
}

/* Hide label visually but keep for accessibility */
.srn-email-signup .newsletter-label {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border-width: 0;
}

/* Placeholder styling */
.srn-email-signup .field__input::placeholder {
  text-transform: uppercase;
  font-stretch: expanded;
  color: var(--srn-signup-light);
  font-family: var(--font-family-secondary);
  text-align: center;
  opacity: 1;
  transition: none;
  font-size: 10px;
}

.srn-email-signup .svg-wrapper {
  text-transform: uppercase;
  font-size: 10px;
  font-stretch: expanded;
  color: var(--srn-signup-light);
}

.srn-email-signup .svg-wrapper svg {
  width: 10px;
  height: 10px;
  display: block;
  margin-top: 5px;
}

.srn-email-signup__form-wrapper .newsletter-form__message--success {
  font-family: var(--font-family-secondary);
  color: var(--srn-signup-light);
  text-transform: uppercase;
  font-stretch: expanded;
  text-align: center;
}

/* ============================================
   DESKTOP BREAKPOINT (700px)
   ============================================ */
@media (min-width: 700px) {
  .srn-email-signup {
    margin-top: 50px;
    margin-bottom: 150px;
  }

  .srn-email-signup__content {
    font-size: 18px;
  }

  .srn-email-signup__text {
    width: 95%;
    font-size: 25px;
    margin-bottom: 25px;
  }

  .srn-email-signup__heading {
    margin: 150px 0 50px 0 !important;
  }

  .srn-email-signup__title {
    font-size: 32px;
    letter-spacing: 2px;
  }

  .srn-email-signup .field__input::placeholder,
  .srn-email-signup .svg-wrapper {
    font-size: 16px;
  }

  .srn-email-signup .svg-wrapper svg {
    width: 16px;
    height: 16px;
  }
}
</style>
